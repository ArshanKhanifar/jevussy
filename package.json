{
  "name": "jevussy",
  "description": "An endless piano, imagined by JEV. Debussy-inspired music that unfolds as you listen.",
  "homepage": "https://jevussy.arshan.to",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arshankhanifar/jevussy.git"
  },
  "bugs": {
    "url": "https://github.com/arshankhanifar/jevussy/issues"
  },
  "author": "Arshan Khanifar",
  "keywords": ["jev", "piano", "generative-music", "debussy", "web-audio", "typescript"],
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "bun run build:piano && bun --bun next dev",
    "build": "bun run build:piano && bun --bun next build",
    "start": "bun --bun next start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "build:piano": "bun build lib/audio/worker.ts --outfile public/piano-worker.js --target browser --minify",
    "test": "bun test"
  },
  "dependencies": {
    "@coderline/alphatab": "1.6.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/bun": "^1.4.2",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
